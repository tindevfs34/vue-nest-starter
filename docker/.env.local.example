# ==============================================
# LOCAL (Docker) — Environment Configuration
# ==============================================

DB_HOST=mysql
DB_PORT=3306
DB_USERNAME=review_user
DB_PASSWORD=review_pass_local
DB_DATABASE=vue_nest_starter

# ---- MYSQL CONTAINER (admin root + auto-created app user) ----
# MYSQL_USER / MYSQL_PASSWORD must match DB_USERNAME / DB_PASSWORD above.
MYSQL_ROOT_PASSWORD=root_pass_local
MYSQL_DATABASE=vue_nest_starter
MYSQL_USER=review_user
MYSQL_PASSWORD=review_pass_local

# ---- JWT ----
JWT_SECRET=local_dev_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=7d

# ---- SEED ----
SEED_ADMIN_PASSWORD=123456

# ---- SERVER ----
PORT=3002
NODE_ENV=development

# CORS settings for frontend applications (CMS on 5173, Web on 3000)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8080
SHOW_SWAGGER=true

# ---- S3 / OBJECT STORAGE (MinIO locally — unified S3_* names with prod) ----
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_NAME=vue-nest-starter-bucket
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# Public URL the browser uses to load uploaded files
STORAGE_BASE_URL=http://localhost:9000/vue-nest-starter-bucket/

# ---- CMS (Vite) ----
VITE_BASE_URL=/
VITE_BASE_API=http://localhost:3002/api/v1
VITE_WEB_URL=http://localhost:3000

# ---- WEB (Nuxt) ----
# Server-side (SSR inside container) -> backend service name
NUXT_API_BASE=http://backend:3002/api/v1
# Client-side (browser)
NUXT_PUBLIC_API_BASE_URL=http://localhost:3002/api/v1
