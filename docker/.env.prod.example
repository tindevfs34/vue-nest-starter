# ==============================================
# PRODUCTION — Environment Configuration
# ==============================================

MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=
MYSQL_USER=
MYSQL_PASSWORD=

# ---- BACKEND API ----
# Must match the MySQL service name in docker-compose.prod.yml
DB_HOST=test-mysql
DB_PORT=3306
# MUST match MYSQL_USER / MYSQL_PASSWORD / MYSQL_DATABASE above (do NOT use root)
DB_USERNAME=
DB_PASSWORD=
DB_DATABASE=
DB_TIMEZONE=+07:00
DB_CONNECTION_LIMIT=20
DB_LOGGING=false
DB_RETRY_ATTEMPTS=5
DB_RETRY_DELAY=5000
DB_SSL_ENABLED=false

JWT_SECRET=
JWT_EXPIRES_IN=1d

# Required if running user seeder in production (min 8 chars)
SEED_ADMIN_PASSWORD=

PORT=3002
API_HOST=0.0.0.0
NODE_ENV=production

CORS_ORIGIN=https://domain.com,https://cms.domain.com
SHOW_SWAGGER=false

# ---- S3 OBJECT STORAGE (External Provider) ----
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET_NAME=
S3_REGION=
S3_FORCE_PATH_STYLE=false
STORAGE_BASE_URL=


# ---- LOGGING ----
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# ---- EMAIL CONFIGURATION ----
MAIL_HOST=
MAIL_PORT=
MAIL_USER=
MAIL_PASS=
MAIL_FROM=
MAIL_TO=
MAIL_CC=

# ---- RATE LIMITING ----
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# ---- CMS (Vue 3 + Vite — baked into static bundle at build time) ----
VITE_BASE_URL=/
VITE_BASE_API=https://api.domain.com/api/v1
VITE_BASE_API_CLOUD=
VITE_WEB_URL=https://domain.com

# ---- WEB (Nuxt 4 SSR) ----
# Server-side (SSR inside container) -> project-prefixed backend service name
NUXT_API_BASE=http://test-backend:3002/api/v1
# Client-side (browser)
NUXT_PUBLIC_API_BASE_URL=https://api.domain.com/api/v1
NUXT_PUBLIC_APP_NAME=
